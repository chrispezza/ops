{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ops",
	"main": "src/index.tsx",
	"compatibility_date": "2026-07-30",
	"assets": {
		"directory": "./public"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ops",
			"database_id": "1c9fe59c-f333-4145-b634-dcbcc8fa40ad",
			"migrations_dir": "./migrations"
		}
	],
	"triggers": {
		// Hourly pollers (github) + daily pollers (anthropic_usage) at ~06:00 ET (10:00 UTC)
		// + the weekly digest push, Fridays ~08:00 ET (12:00 UTC); it runs no pollers.
		"crons": [
			"0 * * * *",
			"0 10 * * *",
			"0 12 * * 5"
		]
	},
	// Deployment specifics live here, never in code (ADR-004). Forking this repo
	// means replacing every value in this block and the d1 database_id above with
	// your own; none of them are secrets (those go in `wrangler secret put`).
	"vars": {
		"GITHUB_OWNERS": "chrispezza,clownware",
		"OPS_URL": "https://ops.chris-d8c.workers.dev",
		"CF_ACCOUNT_ID": "d8c9e6e20235d4f8ac60c6c17d0bbc2e",
		// "owner/repo" of a Claude Code plugin marketplace; omit to leave the manifests poller dormant
		"MARKETPLACE_REPO": "clownware/plugins",
		// How much issue text the judge poller may send to TypeSafe: "all" (title
		// and body for every tracked repo), "titles" (private repos contribute
		// titles only), or "public" (private repos are not judged at all).
		"JUDGE_SCOPE": "all",
		// Comma-separated GitHub logins whose labels do NOT count as ground truth
		// for judge.tier_agreement. GitHub Apps are excluded automatically; this is
		// for automations that label under a person's own PAT, which the API
		// reports as that person. Empty means "trust every human-actor label".
		"JUDGE_CALIBRATION_EXCLUDE": "",
		// Comma-separated GitHub logins of the frontier-model labelling pass whose
		// severity labels are reference ground truth for judge.tier_agreement (the
		// Claude GitHub App here; "[bot]" suffix optional). It is graded against the
		// maintainer in turn (judge.reference_agreement). Empty = human labels only.
		"JUDGE_REFERENCE_ACTORS": "claude",
		// D1 row allowances the cloudflare poller judges d1.read_cap_pct and
		// d1.write_cap_pct against, per day. Empty = the Workers Free daily caps
		// (5M reads, 100k writes). This account is on Workers Paid (2026-09-18),
		// which meters 25B reads and 50M writes per MONTH; these are those figures
		// divided by 30 — the daily pace that keeps the month inside the allowance.
		"D1_ROW_READS_PER_DAY": "833000000",
		"D1_ROW_WRITES_PER_DAY": "1660000",
		// Verify the Cloudflare Access assertion inside the Worker instead of trusting
		// that the edge policy is present. Both must be set to enable it: the team name
		// from <team>.cloudflareaccess.com, and the Access application's AUD tag
		// (Zero Trust → Access → Applications → your app → Overview). Empty = dormant.
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": ""
	},
	"observability": {
		"enabled": true
	}
}